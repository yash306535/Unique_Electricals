{
  "name": "constructionmanager",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "desktop:start": "npm --prefix desktop start",
    "desktop:export-web": "npx expo export --platform web --output-dir desktop/web",
    "desktop:build-win": "npm run desktop:export-web && npm --prefix desktop run build-win"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
